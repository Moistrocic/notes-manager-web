# Dependencies
node_modules/
.pnpm-store/
.npm-cache/

# Build output
dist/
build/
.ssr-out/
*.tsbuildinfo

# Runtime data (notes, sessions, settings)
/data/
/server/data/
/tmp/

# Environment
.env
.env.local
.env.*.local
.npmrc

# Reference clone of OpenList (read-only, never modified, never committed).
# NOTE: anchored with a leading slash - an unanchored "openlist/" would also
# match server/src/openlist/ and silently drop application source from the repo.
/openlist/

# Logs
*.log
logs/
npm-debug.log*
pnpm-debug.log*

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
*.swp

# Test / coverage
coverage/
.nyc_output/
