{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    // The scene library is a submodule whose sources are read here rather than
    // their declarations being consulted; allowJs lets TypeScript read them and
    // checkJs stays off, so its internals are inferred rather than reported on.
    "allowJs": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "types": ["vite/client"]
  },
  "include": [
    "src",
    "vite.config.ts",
    "vite.ssr.config.ts",
    "render-check.tsx",
    "store-check.tsx",
    "outline-check.tsx",
    "dom-check.tsx"
  ],
  // The submodules are other repositories with their own configs and their own
  // strictness. Reading their sources with ours reports their dead parameters
  // as our errors, which says nothing about this project.
  "exclude": ["src/lib/wallpaper-scene-layers"]
}
