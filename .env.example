# ---------------------------------------------------------------------------
# notes-manager-web configuration
#
# Quick start:
#     cp .env.example .env     # then edit .env
#     sudo ./scripts/install.sh
#
# The installer reads THIS file and installs a copy as the runtime
# configuration at <install dir>/.env (default /opt/notes-manager/.env).
# That installed file is what the service actually reads - it is printed at the
# end of the installation, in the startup log, and in the web UI under
# "Settings -> server configuration file".
#
# After installation, edit the runtime file and restart:
#     sudo nano /opt/notes-manager/.env
#     sudo systemctl restart notes-manager
#
# Precedence (highest first):
#     real environment variables  >  this file  >  values saved from the UI  >  defaults
#
# Every value here is optional: the app boots with sensible defaults and also
# works with NO OpenList instance available.
# ---------------------------------------------------------------------------

# --- HTTP server -----------------------------------------------------------
HOST=0.0.0.0
PORT=8080
# Serve the app under a sub path, e.g. /notes  (leave empty for root)
BASE_PATH=
# Public URL used for links/cookies when behind a reverse proxy, e.g. https://notes.example.com
PUBLIC_URL=

# --- Storage driver --------------------------------------------------------
# auto     -> use OpenList when reachable, otherwise fall back to local disk (recommended)
# openlist -> force OpenList (fails loudly when unreachable)
# local    -> always store notes on the local disk
STORAGE_DRIVER=auto

# --- OpenList integration --------------------------------------------------
# >>> 面板显示「OpenList 未配置 / 未连接」，通常就是因为这一行是空的 <<<
#
# OpenList 地址，例如：
#     OPENLIST_URL=http://127.0.0.1:5244       # OpenList 装在同一台机器上
#     OPENLIST_URL=http://192.168.1.10:5244    # OpenList 在另一台机器上
#     OPENLIST_URL=https://openlist.example.com
#
# 留空 = 不使用 OpenList，笔记保存在本机磁盘（功能完全可用）。
# 也可以在登录后于界面「设置 → OpenList 连接」中填写，效果相同。
OPENLIST_URL=

# OpenList API 令牌：OpenList →「设置」→「API」中创建。
# 用「本地管理员」账号读写 OpenList 目录时必须填写；
# 用「OpenList 账号」登录时使用该账号自己的令牌，此处可留空。
OPENLIST_TOKEN=

# 笔记在 OpenList 中的存放目录。
#
# 这里填的是 **OpenList 里的绝对路径**，不是相对路径。面板会按登录账号的
# 「基础路径」(base_path) 自动换算，不会出现 /public/public/Notes 这种重复前缀：
#
#     OPENLIST_ROOT=/public/Notes   账号基础路径=/public   -> 实际访问 /public/Notes
#     OPENLIST_ROOT=/public         账号基础路径=/public   -> 实际访问 /public
#     OPENLIST_ROOT=/notes          账号基础路径=/public   -> 无权访问（该账号被限制在 /public）
#
# 若当前账号无法访问该目录，面板会明确提示「权限不足」，而不是静默失败。
OPENLIST_ROOT=/notes
# Store each user's notes in <OPENLIST_ROOT>/<username> instead of a shared folder.
OPENLIST_PER_USER=false

# --- Local (fallback) storage ---------------------------------------------
# Only used when the active driver is "local".
NOTES_ROOT=./data/notes

# --- Authentication --------------------------------------------------------
# Local account (no public registration exists - this is the only local account).
# If ADMIN_PASSWORD is empty a random one is generated on first start and
# written to <data dir>/initial-admin.txt
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Set to false to only accept OpenList accounts.
AUTH_LOCAL_ENABLED=true

# --- Misc ------------------------------------------------------------------
# Secret used to sign session cookies. Generated on first start when empty.
SESSION_SECRET=
SESSION_TTL_HOURS=72
DATA_DIR=./data
LOG_LEVEL=info
